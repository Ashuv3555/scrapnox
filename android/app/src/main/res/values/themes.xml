<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash theme (Android 12+ system splash + legacy windowBackground) -->
    <style name="Theme.ScrapNox.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/scrapnox_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.ScrapNox</item>
    </style>

    <!-- Main app theme -->
    <style name="Theme.ScrapNox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/scrapnox_green_dark</item>
        <item name="android:navigationBarColor">@color/scrapnox_white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/scrapnox_white</item>
        <!-- Android 15 (API 35) par content ko system bars ke neeche na jaane dein -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
